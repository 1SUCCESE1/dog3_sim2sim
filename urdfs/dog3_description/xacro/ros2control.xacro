<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ros2control">
  <xacro:macro name="ros2control" params="hw_env:='none' ">
    <xacro:if value="${hw_env != 'none'}">
      <gazebo reference="base_imu">
        <sensor name="trunk_imu" type="imu">
          <always_on>true</always_on>
          <update_rate>500</update_rate>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- Gazebo Classic: disable self-collision on robot links (Isaac trains with
         enabled_self_collisions=false; Gazebo defaults to on and jams the legs) -->
    <xacro:if value="${hw_env == 'gazebo'}">
      <gazebo reference="base_link"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FL_hip"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FL_thigh"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FL_calf"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="LF_FOOT"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FR_hip"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FR_thigh"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="FR_calf"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RF_FOOT"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RL_hip"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RL_thigh"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RL_calf"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="LH_FOOT"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RR_hip"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RR_thigh"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RR_calf"><selfCollide>false</selfCollide></gazebo>
      <gazebo reference="RH_FOOT"><selfCollide>false</selfCollide></gazebo>
    </xacro:if>

    <!-- Gazebo Classic: this <gazebo> plugin starts the controller_manager -->
    <xacro:if value="${hw_env == 'gazebo'}">
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>$(find gazebo_bridge)/config/controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <ros2_control name="${hw_env}Bridge" type="system">
      <hardware>
        <xacro:if value="${hw_env == 'webots'}">
          <plugin>tita_webots_ros2_control::WebotsBridge</plugin>
        </xacro:if>
        <xacro:if value="${hw_env == 'gazebo'}">
          <plugin>usr_gazebo_ros2_control/GazeboBridge</plugin>
        </xacro:if>
        <xacro:if value="${hw_env == 'hw'}">
          <plugin>tita_locomotion::HardwareBridge</plugin>
        </xacro:if>
      </hardware>

      <xacro:macro name="dog3_joint" params="name init">
        <joint name="${name}">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort">
            <param name="min">-20</param>
            <param name="max">20</param>
          </command_interface>
          <command_interface name="kp"/>
          <command_interface name="kd"/>
          <state_interface name="position">
            <param name="initial_value">${init}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- joint zero == standing stance (URDF origins shifted by the default
           angles: thigh +0.7, calf -1.44), so all initial values are 0 -->
      <xacro:dog3_joint name="FL_hip_joint"   init="0.0"/>
      <xacro:dog3_joint name="FL_thigh_joint" init="0.0"/>
      <xacro:dog3_joint name="FL_calf_joint"  init="0.0"/>
      <xacro:dog3_joint name="FR_hip_joint"   init="0.0"/>
      <xacro:dog3_joint name="FR_thigh_joint" init="0.0"/>
      <xacro:dog3_joint name="FR_calf_joint"  init="0.0"/>
      <xacro:dog3_joint name="RL_hip_joint"   init="0.0"/>
      <xacro:dog3_joint name="RL_thigh_joint" init="0.0"/>
      <xacro:dog3_joint name="RL_calf_joint"  init="0.0"/>
      <xacro:dog3_joint name="RR_hip_joint"   init="0.0"/>
      <xacro:dog3_joint name="RR_thigh_joint" init="0.0"/>
      <xacro:dog3_joint name="RR_calf_joint"  init="0.0"/>

      <sensor name="trunk_imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>

    </ros2_control>
  </xacro:macro>
</robot>
